{
    "name": "protendai/nativephp-billing",
    "description": "In-app purchases for NativePHP Mobile v4: Google Play Billing on Android and StoreKit 2 on iOS. Subscriptions with offers and free trials, one-time and consumable products, restore, acknowledge and consume, with purchase tokens and signed transactions for server-side verification.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "nativephp-plugin",
        "billing",
        "in-app-purchase",
        "subscriptions",
        "google-play",
        "play-billing",
        "app-store",
        "storekit",
        "laravel",
        "mobile"
    ],
    "homepage": "https://github.com/protendai/nativephp-billing",
    "support": {
        "issues": "https://github.com/protendai/nativephp-billing/issues",
        "source": "https://github.com/protendai/nativephp-billing"
    },
    "authors": [
        {
            "name": "Tendai Karuma",
            "email": "karumatendai@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Protendai\\Billing\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Protendai\\Billing\\BillingServiceProvider"
            ],
            "aliases": {
                "Billing": "Protendai\\Billing\\Facades\\Billing"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
